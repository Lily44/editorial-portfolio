---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'portfolio'>;
}

const { project } = Astro.props;
const { title, icon, category, date, summary, tags,
  featuredImage, altText, } = project.data;
const projectSlug = project.id;
const projectUrl = projectSlug === 'design-system' ? '/design-system' : `/portfolio/${projectSlug}`;
---

<article class="portfolio-card group relative border border-[var(--color-ink-muted)] p-6 flex flex-col justify-between transition-colors duration-300 hover:border-[var(--color-accent)] bg-[var(--color-paper)]">
  <div>
    <div class="flex justify-between items-center text-xs font-mono mb-3 text-[var(--color-ink-muted)]">
      <span class="text-base">{icon}</span>
      <span class="uppercase tracking-wider">{category}</span>
    </div>
    {featuredImage && (
      <img
        src={featuredImage}
        alt={altText || title}
        class="w-full aspect-[16/10] object-cover mb-6"
      />
    )}
    <h3 class="text-2xl font-serif font-bold mb-3 leading-snug">
      <a href={projectUrl} class="hover:text-[var(--color-accent)] underline decoration-1 underline-offset-4">
        {title}
      </a>
    </h3>
    <p class="text-sm leading-relaxed mb-6 font-serif">
      {summary}
    </p>
  </div>
  <div>
    <time datetime={date} class="block text-xs font-mono text-[var(--color-ink-muted)] mb-3">
      Published: {date}
    </time>
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="text-xs font-mono bg-[var(--color-ink)] text-[var(--color-paper)] px-2 py-0.5">
          {tag}
        </span>
      ))}
    </div>
  </div>
</article>
