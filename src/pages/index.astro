---
import Layout from '../layouts/Layout.astro';
import Masthead from '../components/Masthead.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('portfolio');
const designSystem = projects.find((project) => project.id === 'design-system');
const otherProjects = projects.filter((project) => project.id !== 'design-system');
const orderedProjects = designSystem
  ? [...otherProjects, designSystem]
  : otherProjects;
---

<Layout title="THE NARRATIVE | Lori Olson — UI/UX Designer-Developer">
  <div class="max-w-6xl mx-auto">
    <Masthead />

    <main id="main-content">
      <!-- Top Grid: Lead Feature + Aside (Backstory & Accessibility Guarantee) -->
      <section id="lead-feature-row" class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-12 pb-12 border-b border-[var(--color-ink)] items-stretch">
        
        <!-- Main / Lead Feature (Left Column) -->
        <article class="md:col-span-7 md:border-r md:border-[var(--color-ink)] md:pr-8 flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono uppercase tracking-widest text-[var(--color-accent)] block mb-2 font-bold">Lead Feature</span>
            <h2 id="about-heading" class="text-3xl md:text-5xl font-serif font-bold leading-tight mb-4">
              Designing Accessible, Human-Centered Digital Experiences.
            </h2>
            <p class="text-base md:text-lg font-serif leading-relaxed mb-4">
              Welcome to my portfolio. I specialize in bridging the gap between high-impact visual design and clean, accessible front-end architecture. With a deep commitment to WCAG guidelines, performance, and modern editorial typography, I build web solutions that everyone can navigate seamlessly.
            </p>
            <p class="text-base font-serif leading-relaxed">
              Whether refactoring complex interface components for WCAG 2.2 AA compliance or engineering responsive design systems, my focus remains grounded in usability, craft, and code clarity.
            </p>
          </div>
        </article>

        <!-- Aside: Backstory + Accessibility Guarantee (Right Column) -->
        <aside class="md:col-span-5 flex flex-col justify-between">
          <!-- Top: The Backstory -->
          <div class="mb-6">
            <span class="text-xs font-mono uppercase tracking-widest text-[var(--color-accent)] block mb-1 font-bold">Profile & Biography</span>
            <h3 class="text-lg font-serif font-bold border-b border-[var(--color-ink)] pb-1 mb-3 uppercase tracking-wide">
              The Backstory
            </h3>
            <p class="drop-cap text-sm font-serif leading-relaxed mb-3">
              Hi! I'm Lori and I build accessible, story-driven interactive experiences for the web. Eleven years in, I still care most about the same thing: making sure the people a story is meant to reach can actually get to it.
            </p>
            <p class="text-xs font-serif leading-relaxed text-[var(--color-ink-muted)] mb-3">
              My work spans corporate product design and higher ed, but the pieces I'm proudest of live in interactive documentaries, scroll-driven data visualization, and accessibility work that treats inclusion as a human question, not a compliance one.
            </p>
            <p class="text-xs font-serif leading-relaxed text-[var(--color-ink-muted)] mb-3">
              Looking for teams where narrative and craft matter equally: public media, journalism, nonprofits, mission-driven organizations.
            </p>
            <p class="text-[11px] font-mono uppercase tracking-wider font-bold text-[var(--color-ink-muted)] border-t border-[var(--color-ink)] pt-2">
              Minneapolis-based. Always building something.
            </p>
          </div>

          <!-- Bottom: Accessibility Guarantee -->
          <div class="border-t border-[var(--color-ink)] pt-4">
            <h3 class="text-sm font-serif font-bold border-b border-[var(--color-ink)] pb-1 mb-2 uppercase tracking-wide">
              Accessibility Guarantee
            </h3>
            <p class="text-xs font-serif leading-relaxed mb-3 text-[var(--color-ink-muted)]">
              This publication is engineered to adhere strictly to WCAG 2.2 Level AA guidelines. It features keyboard-operable controls, explicit contrast ratios exceeding 15:1, screen-reader semantics, and respected motion preferences.
            </p>
            <span class="text-[11px] font-mono uppercase font-bold text-[var(--color-accent)] block">
              WCAG 2.2 AA Compliant Edition
            </span>
          </div>
        </aside>

      </section>

      <!-- Portfolio Grid Section -->
      <section aria-labelledby="works-heading" class="mb-12">
        <div class="border-y-4 border-double border-[var(--color-ink)] py-2 mb-8 flex justify-between items-center">
          <h2 id="works-heading" class="text-xl font-serif font-bold uppercase tracking-wider">
            Selected Works & Case Studies
          </h2>
          <span class="font-mono text-xs">{projects.length} Issues Enclosed</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {orderedProjects.map((project) => (
            <PortfolioCard project={project} />
          ))}
        </div>
      </section>
    </main>
  </div>
</Layout>

<script>
  import { gsap } from 'gsap';

  const mm = gsap.matchMedia();

  mm.add("(prefers-reduced-motion: no-preference)", () => {
    const tl = gsap.timeline({ defaults: { ease: "power3.out", duration: 0.7 } });

    tl.from("#lead-feature-row", {
      opacity: 0,
      y: 12,
    })
    .from(".portfolio-card", {
      opacity: 0,
      y: 20,
      stagger: 0.15,
    }, "-=0.3");

    const cards = document.querySelectorAll('.portfolio-card');
    cards.forEach((card) => {
      card.addEventListener('mouseenter', () => {
        gsap.to(card, { y: -4, duration: 0.2, ease: "power1.out" });
      });
      card.addEventListener('mouseleave', () => {
        gsap.to(card, { y: 0, duration: 0.2, ease: "power1.out" });
      });
    });
  });
</script>
