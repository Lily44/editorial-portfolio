---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen p-4 md:p-8">
    <div role="region" aria-label="Accessibility tools">
      <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-[var(--color-paper)] focus:text-[var(--color-ink)] border-2 border-[var(--color-ink)]">
        Skip to main content
      </a>
    </div>
    <slot />
    <footer class="mt-16 border-t border-[var(--color-ink-muted)] pt-4 pb-2 font-mono text-xs text-[var(--color-ink-muted)]">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p>&copy; 2026 Lori Olson</p>
        <nav aria-label="Footer navigation" class="flex flex-wrap gap-x-4 gap-y-2">
          <a href="mailto:lolsonportfolio@icloud.com" class="underline underline-offset-4 hover:text-[var(--color-accent)]">
            Contact
          </a>
          <a href="#" class="underline underline-offset-4 hover:text-[var(--color-accent)]">
            Back to top
          </a>
        </nav>
      </div>
    </footer>
  </body>
</html>
